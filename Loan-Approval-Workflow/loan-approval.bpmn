        <zeebe:calledDecision decisionId="risk-level-detection" resultVariable="riskLevel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kh0mxa</bpmn:incoming>
      <bpmn:outgoing>Flow_1wjf7pi</bpmn:outgoing>
