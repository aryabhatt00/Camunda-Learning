  <bpmn:process id="loan-approval" name="Loan Approval Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0u0n2qo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0u0n2qo" sourceRef="StartEvent_1" targetRef="Activity_1tlp4tz" />
    <bpmn:sequenceFlow id="Flow_0kh0mxa" sourceRef="Activity_1tlp4tz" targetRef="Activity_0k40dvr" />
    <bpmn:exclusiveGateway id="Gateway_18hr7x9" name="High Risk?">
      <bpmn:incoming>Flow_1wjf7pi</bpmn:incoming>
      <bpmn:outgoing>Flow_0ez3pzc</bpmn:outgoing>
      <bpmn:outgoing>Flow_0z7u3xo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1wjf7pi" sourceRef="Activity_0k40dvr" targetRef="Gateway_18hr7x9" />
    <bpmn:sequenceFlow id="Flow_0ez3pzc" name="No" sourceRef="Gateway_18hr7x9" targetRef="Activity_1vcj1j7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel != "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0z7u3xo" name="Yes" sourceRef="Gateway_18hr7x9" targetRef="Activity_0ixfhpg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel = "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0xdvmeg" sourceRef="Activity_0ixfhpg" targetRef="Event_149evg5" />
    <bpmn:exclusiveGateway id="Gateway_12bo1eb" name="Rejection/Approval">
      <bpmn:incoming>Flow_1ntp6pd</bpmn:incoming>
      <bpmn:outgoing>Flow_0vycuqh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0z74uy2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ntp6pd" sourceRef="Activity_1vcj1j7" targetRef="Gateway_12bo1eb" />
    <bpmn:userTask id="Activity_1vcj1j7" name="Manager Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ez3pzc</bpmn:incoming>
      <bpmn:outgoing>Flow_1ntp6pd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_0ixfhpg" name="Send Rejection Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-email" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0z7u3xo</bpmn:incoming>
      <bpmn:outgoing>Flow_0xdvmeg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0vycuqh" name="approved" sourceRef="Gateway_12bo1eb" targetRef="Activity_1g45666">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerApproval = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1pbgy3d" sourceRef="Activity_1g45666" targetRef="Event_0f0whos" />
    <bpmn:serviceTask id="Activity_1g45666" name="Send Approval Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-approval-email" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vycuqh</bpmn:incoming>
      <bpmn:outgoing>Flow_1pbgy3d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Activity_0z760kz" name="Send Rejection Email">
      <bpmn:incoming>Flow_0z74uy2</bpmn:incoming>
      <bpmn:outgoing>Flow_0h3p76m</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0z74uy2" sourceRef="Gateway_12bo1eb" targetRef="Activity_0z760kz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerApproval=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0h3p76m" sourceRef="Activity_0z760kz" targetRef="Event_1025ia4" />
